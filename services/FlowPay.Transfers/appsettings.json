{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=flowpay-db;Port=5432;Database=flowpay_transfers;Username=flowpay;Password=flowpay"
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-do-not-use-in-production-1234567890",
    "Issuer": "FlowPay.Identity",
    "Audience": "FlowPay",
    "AccessTokenLifetimeMinutes": 60
  },
  "InternalApi": {
    "ApiKey": "dev-only-internal-api-key-do-not-use-in-production-1234567890"
  },
  "Services": {
    "Wallet": "http://flowpay-wallet:8080",
    "Ledger": "http://flowpay-ledger:8080",
    "Notifications": "http://flowpay-notifications:8080"
  },
  "TransferPolicy": {
    "MaxPerTransactionMinorUnits": 1000000,
    "MaxDailyMinorUnits": 2000000,
    "ExternalTransferFeeMinorUnits": 150
  }
}
